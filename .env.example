PORT=43123
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=marti
DATABASE_PASSWORD=marti
DATABASE_NAME=marti_location
DATABASE_POOL_MAX=30
DATABASE_LOGGING=false

# Demo polygons when `areas` is empty. Use false outside local/demo.
